# Iterative factorial: a single running product accumulator.
# State update per step: (n, acc) -> (n-1, acc*n); returns acc at n == 0.
#
# A *non-linear* recurrence (a product). loop_to_recursion is structural, so it
# recurses it anyway. accumulator_elim DECLINES: the update acc*n reads the
# driver n, so the classifier demotes acc to a driver (nothing to eliminate).
lambda fact:
<entry @input:i64>
    goto <head @n=@input @acc=1>;

<head @n:i64 @acc:i64>
    %done = @n == 0;
    if %done goto <exit @r=@acc> else goto <body @m=@n @a=@acc>;

<body @m:i64 @a:i64>
    %na = @a * @m;
    %m1 = @m - 1;
    goto <head @n=%m1 @acc=%na>;

<exit @r:i64>
    return @r;
