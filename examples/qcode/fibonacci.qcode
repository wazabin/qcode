# Iterative Fibonacci: two rolling accumulators (a, b) and a down-counter hn.
# State update per step: (hn, a, b) -> (hn-1, b, a+b); returns a at hn == 0.
#
# A *linear* recurrence whose accumulator update reads only accumulators, so:
#   loop_to_recursion -> tail-recursive fib_loop_rec(hn, a, b)
#   accumulator_elim  -> g(hn) returning (a, b); host projects field 0   (3 params -> 1)
lambda fib_loop:
<entry @input:i64>
    goto <head @hn=@input @a=0 @b=1>;

<head @hn:i64 @a:i64 @b:i64>
    %done = @hn == 0;
    if %done goto <exit @r=@a> else goto <body @m=@hn @x=@a @y=@b>;

<body @m:i64 @x:i64 @y:i64>
    %next = @x + @y;
    %m1 = @m - 1;
    goto <head @hn=%m1 @a=@y @b=%next>;

<exit @r:i64>
    return @r;
