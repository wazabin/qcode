# The REAL MT19937 seeding loop: fills the 624-word state array in place.
#   mt[0]   = seed
#   mt[i]   = 1812433253 * (mt[i-1] ^ (mt[i-1] >> 30)) + i,   i = 1..624
#
# Unlike mt19937_recur.qcode (the pure scalar core, array writes elided, carries
# `prev` and returns it), this is the honest lifting:
#   - it is IMPURE -> a `fn`, not a `lambda`: every step STOREs mt[i] to `ram`;
#   - the carried dependency runs THROUGH MEMORY: each step LOADs mt[i-1] that
#     the previous step stored. Element depends on previous-and-index: that is a
#     `scan`, not a tail recursion, so neither loop_to_recursion nor
#     accumulator_elim is the tool for it (see the recur example's header).
#
# Words are 32-bit: i32 arithmetic wraps mod 2^32, which is exactly MT's masking,
# so no explicit `& 0xffffffff` is needed. `@base` points at mt[0]; addresses are
# pointer-width (i64) `@base + i*4`. Returns nothing (void: `return at i64 0x0`);
# the filled array is observed through `@base`, never returned by value.
fn mt_init:
<entry @seed:i64 @base:i64>
    # mt[0] = seed (low 32 bits — integer truncation, not float→int `trunc`)
    %e0 = @seed[0:4];
    store(ram:4, @base <- %e0);
    goto <head @i=1 @buf=@base>;

<head @i:i64 @buf:i64>
    %done = @i == 624;
    if %done goto <exit> else goto <body @j=@i @b=@buf>;

<body @j:i64 @b:i64>
    # prev = mt[j-1]  (reloaded from the store the previous step made)
    %jm1 = @j - 1;
    %roff = %jm1 * 4;
    %raddr = @b + %roff;
    %prev = load(ram:4, %raddr);
    # next = 1812433253 * (prev ^ (prev >> 30)) + j
    %sh = %prev >> 30;
    %xo = %prev ^ %sh;
    %ml = %xo * 1812433253;
    # narrow the i64 loop index to i32 (low 4 bytes) — an *integer* truncation
    # (`trunc(i32, …)` is float→int and is the wrong op for an integer index).
    %jt = @j[0:4];
    %next = %ml + %jt;
    # mt[j] = next
    %woff = @j * 4;
    %waddr = @b + %woff;
    store(ram:4, %waddr <- %next);
    %j1 = @j + 1;
    goto <head @i=%j1 @buf=@b>;

<exit>
    return at i64 0x0;
