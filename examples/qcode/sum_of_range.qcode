# Sum of 0..n via an ascending counter compared to a carried bound.
# State update per step: (i, s, bound) -> (i+1, s+i, bound); returns s at i == bound.
#
# Two reasons accumulator_elim DECLINES here (both sound):
#   - s's update s+i reads the driver i  -> s is demoted to a driver
#   - bound is loop-invariant            -> a dead_lambda_args pass's job, not this one
# loop_to_recursion still recurses it structurally.
lambda sum_up:
<entry @input:i64>
    goto <head @i=0 @s=0 @bound=@input>;

<head @i:i64 @s:i64 @bound:i64>
    %done = @i == @bound;
    if %done goto <exit @r=@s> else goto <body @j=@i @t=@s @bd=@bound>;

<body @j:i64 @t:i64 @bd:i64>
    %s2 = @t + @j;
    %j1 = @j + 1;
    goto <head @i=%j1 @s=%s2 @bound=@bd>;

<exit @r:i64>
    return @r;
