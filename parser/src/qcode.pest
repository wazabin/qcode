WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
COMMENT    = _{ "#" ~ (!"\n" ~ ANY)* }

program         =  { SOI ~ statement_list? ~ EOI }
statement_list  =  { compound_stmt ~ (";" ~ compound_stmt)* ~ ";"* }
compound_stmt   =  { label+ ~ inner_stmt? | inner_stmt }
inner_stmt      =  { local_decl | assignment | terminator | expr }
local_decl      =  { "local" ~ ty ~ ident ~ ("as" ~ ident)? }
assignment      =  { assignment_ssa | assignment_plain }
assignment_ssa  =  { &(ty? ~ ssa_name ~ eq) ~ ty? ~ ssa_name ~ eq ~ expr }
assignment_plain =  { &(ident ~ eq) ~ ident ~ eq ~ expr }
assignment_stmt =  { SOI ~ assignment ~ EOI }
label           =  { "<" ~ ident ~ ">" }
label_stmt      =  { SOI ~ label ~ EOI }
terminator      =  { return_stmt | branchind_stmt | callind_stmt | cbranch_stmt | branch_stmt | call_stmt }
terminator_stmt =  { SOI ~ terminator ~ EOI }
branch_stmt     =  { "goto" ~ label }
branchind_stmt  =  { "goto" ~ "[" ~ typed_atom ~ "]" }
cbranch_stmt    =  { "if" ~ typed_atom ~ "goto" ~ label ~ "else" ~ "goto" ~ label }
call_stmt       =  { "call" ~ label }
callind_stmt    =  { "call" ~ "[" ~ typed_atom ~ "]" }
return_stmt     =  { "return" ~ "[" ~ typed_atom ~ "]" }
expr            =  { memory | cast | unop | func_unop | func_call | binary | atom_expr }
expr_stmt       =  { SOI ~ expr ~ EOI }
atom_expr       =  { typed_atom }
unop            =  { unop_op ~ typed_atom }
func_unop       =  { func_unop_op ~ "(" ~ typed_atom ~ ")" }
func_call       =  { func_ident ~ "(" ~ typed_atom ~ ("," ~ typed_atom)? ~ ")" }
binary          =  { typed_atom ~ op ~ typed_atom }
memory          =  { load | store }
load            =  { "load" ~ "(" ~ ty ~ "," ~ typed_atom ~ ")" }
store           =  { "store" ~ "(" ~ typed_atom ~ "," ~ typed_atom ~ ")" }
cast            =  { cast_op ~ "(" ~ ty ~ "," ~ typed_atom ~ ")" }
cast_op         =  { "zext" | "sext" | "int2float" | "float2float" | "trunc" }
typed_atom      =  { ty? ~ atom }
atom            =  { capture | ssa_name | ident | integer }
capture         =  { "{" ~ ident ~ "}" }
ssa_name        = @{ "%" ~ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }
ident           = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }
integer         = @{ hex_int | dec_int }
hex_int         =  { "0" ~ ("x" | "X") ~ ASCII_HEX_DIGIT+ }
dec_int         =  { ASCII_DIGIT+ }
ty              = @{ ("i" | "f") ~ ASCII_DIGIT+ }
op              =  { "s>>" | "s<=" | "s>=" | "s<" | "s>" | "s/" | "s%" | "f<=" | "f>=" | "f==" | "f!=" | "f<" | "f>" | "f+" | "f-" | "f*" | "f/" | "<<" | ">>" | "<=" | ">=" | "==" | "!=" | "^^" | "&&" | "||" | "+" | "-" | "*" | "/" | "%" | "&" | "|" | "^" | "<" | ">" }
unop_op         =  { "!" | "~" | "-" | "f-" }
func_unop_op    =  { "abs" | "sqrt" | "floor" | "ceil" | "round" }
func_ident      =  { "nan" | "popcount" | "lzcount" | "carry" | "scarry" | "sborrow" }
eq              =  { "=" ~ !"=" }
